@page "/register"

<PageTitle>Create Account — CVScanner</PageTitle>

<div class="auth-container">
    <form class="auth-card" method="post" action="/account/register">
        <AntiforgeryToken />

        <div class="auth-header">
            <div class="logo-mark">⚡</div>
            <h1>Create account</h1>
            <p>Start scanning and matching CVs with AI</p>
        </div>

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert-error">@Error</div>
        }

        <div class="form-group">
            <label>Full Name</label>
            <input type="text" name="fullName" placeholder="Jane Smith" class="form-input" required />
        </div>
        <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" placeholder="you@example.com" class="form-input" required />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" name="password" placeholder="Min. 8 characters, include a number" class="form-input" required />
        </div>

        <button type="submit" class="btn-primary">Create account →</button>

        <p class="auth-link">Already have an account? <a href="/login">Sign in</a></p>
    </form>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}